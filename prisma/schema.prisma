generator client {
  provider   = "prisma-client-js"
  engineType = "client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}
model Business {
  id             String   @id
  businessName   String
  registrationNo String   @unique
  ownerName      String
  email          String   @unique
  phone          String
  address        String
  city           String
  state          String
  pincode        String
  createdAt      DateTime @default(now())
  users          User[]
}

model User {
  id         String    @id
  name       String
  email      String    @unique
  password   String
  role       String
  businessId String?
  createdAt  DateTime  @default(now())
  business   Business? @relation(fields: [businessId], references: [id])
}

model Instrument {
  id               String        @id
  name             String
  manufacturer     String
  model            String
  serialNumber     String        @unique
  location         String
  type             String
  capacity         String
  validUntil       String
  status           String
  lastVerified     String
  nextVerification String
  applications     Application[]
}

model Application {
  id            String       @id
  business      String
  instrument    String
  type          String
  location      String
  submitted     String
  priority      String
  status        String
  instrumentId  String?
  instrumentRef Instrument?  @relation(fields: [instrumentId], references: [id])
  certificate   Certificate?
}

model Certificate {
  id            String      @id
  applicationId String      @unique
  business      String
  instrument    String
  issuedDate    String
  validUntil    String
  status        String
  qrCode        String
  application   Application @relation(fields: [applicationId], references: [id])
}
